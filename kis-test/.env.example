# Supabase 프로젝트 설정
# Supabase 대시보드 → Project Settings → API 에서 확인

# Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# service_role 키 (anon 키 X — RLS 우회용)
# ⚠️ 절대 git 에 커밋하지 마세요
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────
# KIS API (한국투자증권) 설정
# KIS 개발자 포털 가입 후 앱 등록: https://apiportal.koreainvestment.com
# ⚠️ 절대 git 에 커밋하지 마세요
# ──────────────────────────────────────────────

# 발급받은 앱키 (영문+숫자 36자)P0000000-0000-0000-0000-000000000000
KIS_APP_KEY=

# 발급받은 앱시크릿 (영문+숫자 180자)
KIS_APP_SECRET=your-app-secret

# ──────────────────────────────────────────────
# 텔레그램 봇 (일봉 스캔 후 구독자 알림 — GitHub Actions 포함)
# @BotFather 에서 발급
# ⚠️ 절대 git 에 커밋하지 마세요
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
