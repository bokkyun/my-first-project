# Supabase
# Supabase Dashboard > Project Settings > API 에서 복사
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google AdSense 슬롯 ID
# AdSense 대시보드 > 광고 > 광고 단위에서 생성 후 입력
# Cloudflare Pages > Settings > Environment variables 에 동일하게 등록
VITE_AD_SLOT_HORIZONTAL=여기에_가로형_슬롯ID_입력
VITE_AD_SLOT_SIDEBAR=여기에_사이드바_슬롯ID_입력
